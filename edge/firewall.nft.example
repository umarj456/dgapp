# Dedicated-VM sketch only. Do NOT load this on 138.201.138.161.
# That host uses firewalld. A second table with policy drop can cut off SSH and the live apps.
# On 138, add the firewalld rich rules in EDGE_DEPLOY.md (UDP 15060 from SIPNAV, TCP 18443, UDP 35000-35999).
# nftables sketch for a future edge VM. SIP/UDP only from SIPNAV; WSS from anywhere.
table inet dgedge {
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    iif lo accept
    tcp dport 22 ip saddr { ADMIN_IP } accept
    tcp dport { 80, 443, 8443 } accept                 # certbot + WSS
    udp dport 5060 ip saddr { SIPNAV_IP } accept       # signalling from SIPNAV only
    udp dport 30000-40000 accept                       # RTP / SRTP media
    ip protocol icmp accept
  }
}
