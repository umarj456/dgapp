# Compose interpolation only (copy to .env). Placeholders — never put live keys here.
# Dedicated machine with Docker. A shared host such as the surveyed app server
# should follow DEPLOY_LOCAL.md (Node + its own Postgres) and leave these unused.
COMPOSE_PROJECT_NAME=dgapp

# Host addresses. 127.0.0.1 keeps the stack off other interfaces.
# Set WEB_BIND to a private IP or 0.0.0.0 only on a lab machine with no public exposure.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
API_BIND=127.0.0.1
API_PORT=8080
WEB_BIND=127.0.0.1
WEB_PORT=5173

# Must match the URL opened in the browser (loopback or private IP, no public DNS).
WEB_ORIGIN=http://127.0.0.1:5173

# Dev placeholders. Replace the database password on any shared machine.
POSTGRES_PASSWORD=dgapp
INTERNAL_API_TOKEN=change-me-dev-only
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Placeholders until Umar creates the SIPNAV DG App account and DNS exists.
# Quotes are required so the # is part of the placeholder prefix.
SIPNAV_TECH_PREFIX="05436#"
SIP_REALM=sip.dialergiants.example
SIP_WSS_URL=wss://sip.dialergiants.example:8443/ws
