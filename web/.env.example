# Copy to web/.env for the Node path (npm run dev). Do not use this file with Docker
# Compose — compose sets VITE_PROXY_TARGET=http://api:8080 itself.
# Empty API base: the Vite dev server proxies /v1, so the browser stays same-origin.
VITE_API_BASE=
# Isolated host API (loopback). Match backend PORT.
VITE_PROXY_TARGET=http://127.0.0.1:4100
# 127.0.0.1 = this machine only (SSH tunnel). 0.0.0.0 = private-IP lab, still no public DNS.
VITE_HOST=127.0.0.1
VITE_PORT=4200
# Browser copy of STRIPE_PUBLISHABLE_KEY. Placeholder only. Never put a secret key in a VITE_ variable.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
