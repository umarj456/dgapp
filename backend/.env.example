# DG App API — copy to backend/.env for the Node path. NEVER commit real values.
# Isolated folder on a shared Linux host (see DEPLOY_LOCAL.md):
#   loopback only, API :4100, dedicated Postgres :5433. Do not use :8080 or :5432.
NODE_ENV=development
HOST=127.0.0.1
PORT=4100
DATABASE_URL=postgres://dgapp:dgapp@127.0.0.1:5433/dgapp

# Shared secret the Kamailio edge sends as "Authorization: Bearer ..." to /internal/*
# Replace on any shared machine. The default is refused when NODE_ENV=production.
INTERNAL_API_TOKEN=change-me-dev-only
# Comma-separated source IPs allowed to call /internal/* (edge private IP in prod)
INTERNAL_ALLOWED_IPS=127.0.0.1,::1,::ffff:127.0.0.1

# OTP delivery. console prints codes in the API process log (dev only).
# smtp and twilio are accepted by config and refused at send time until a vendor is wired.
# NODE_ENV=production refuses OTP_PROVIDER=console.
OTP_PROVIDER=console
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# SIP / edge. Example host is not a live DNS name. Real calls need the edge + SIPNAV.
SIP_REALM=sip.dialergiants.example
SIP_WSS_URL=wss://sip.dialergiants.example:8443/ws
# Tech prefix of the (not yet created) "DG App" account on SIPNAV. PLACEHOLDER.
SIPNAV_TECH_PREFIX=05436#

# Stripe. Stub mode makes no network calls and accepts unsigned webhooks (dev only).
# The web UI completes KYC and top-ups against that webhook while stub mode is on.
# NODE_ENV=production refuses STRIPE_STUB_MODE=true. Live keys come from Umar, out of band.
STRIPE_STUB_MODE=true
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Limits
MAX_CALL_SECONDS=14400
MIN_CALL_SECONDS=6
DID_COOLDOWN_DAYS=30
# true loads fictional 555-01xx DIDs and placeholder rates (migration 003). Not a SIPNAV inventory.
MIGRATE_DEV_SEED=true
# Exact browser origin. Loopback install: http://127.0.0.1:4200
# Private-IP lab (no public DNS): http://<private-ip>:<web-port>
WEB_ORIGIN=http://127.0.0.1:4200
